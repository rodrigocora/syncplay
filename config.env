# Non-secret configuration for the syncplay-history container.
# Committed to the repo; loaded by entrypoint.sh at startup.
# Real environment variables (docker run -e) override values set here.
# Secrets (DB_PASS, SYNCPLAY_PASSWORD) belong in .secrets.env, NOT here.

# --- ports ---
# Internal port the syncplay server listens on (the proxy forwards to it).
SYNCPLAY_PORT=12345
# Port clients connect to (the proxy).
PROXY_PORT=12346

# --- database connection (non-secret parts) ---
# Leave DB_HOST empty to use the built-in SQLite default (sqlite:////data/history.sqlite).
DB_HOST=10.8.0.11
DB_PORT=5432
DB_USER=syncplay_user
DB_NAME=syncplay_history
# DB_PASS lives in .secrets.env

# --- syncplay server options (all optional) ---
# SYNCPLAY_SALT is a stable random string for controlled-room operator
# passwords; it may be kept secret in .secrets.env, or set here if you do not
# mind it being committed.
# SYNCPLAY_SALT=
SYNCPLAY_ISOLATE_ROOMS=false
SYNCPLAY_DISABLE_READY=false
SYNCPLAY_DISABLE_CHAT=false
# SYNCPLAY_MOTD_FILE=
# SYNCPLAY_ROOMS_DB_FILE=/data/rooms.sqlite
# SYNCPLAY_PERMANENT_ROOMS_FILE=/data/permanent_rooms.txt
# SYNCPLAY_MAX_CHAT_MESSAGE_LENGTH=150
# SYNCPLAY_MAX_USERNAME_LENGTH=16
# SYNCPLAY_STATS_DB_FILE=/data/stats.sqlite
# SYNCPLAY_TLS_PATH=/app/tls
SYNCPLAY_IPV4_ONLY=false
SYNCPLAY_IPV6_ONLY=false
# SYNCPLAY_INTERFACE_IPV4=
# SYNCPLAY_INTERFACE_IPV6=
