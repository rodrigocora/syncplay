# Template for .secrets.env -- copy to .secrets.env and fill in.
# .secrets.env is gitignored; only secrets belong here. Loaded by entrypoint.sh.
# Values set here are overridden by real environment variables (docker run -e).

# Watch-history database password (the DB_* non-secret parts live in config.env).
DB_PASS=

# Optional: syncplay server password (MD5-hashed by the server itself).
# SYNCPLAY_PASSWORD=

# Optional: stable salt so controlled-room operator passwords survive restarts.
# SYNCPLAY_SALT=
